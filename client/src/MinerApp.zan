using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class MinerApp {
    public Canvas c;
    public World w;
    public Snd snd;
    public Rng uiRng;

    public long now;

    // 纹理路径(assets 定位;null = 缺失,画矢量兜底)
    public string bgPath;
    // 朝向精灵表（离线烘焙，运行时按角度取帧）
    public string clawSheetPath;   // assets/claw_sheet.png（12 方向帧）
    public string minerSheetPath;  // assets/miner_sheet.png（左右两帧）
    // 场景与物件
    public string campPath;  // 天空带画面(0..SKY_H)
    public string minePath;  // 地层画面(SKY_H..H)
    public string glowPath;  // 柔光晕(拆弹警示底光)
    public string dynPath;   // 炸药随身包图标(顶栏)
    public string bombPath;  // 炸弹贴图(场上道具 + 拆弹弹体)
    // 美术底板（九宫格自切，程序化烘出）
    public string hudBoardPath;   // HUD 顶栏底板
    public string bombBoardPath;  // 拆弹面板底板
    public string troughPath;     // 进度条凹槽
    public string gaugePath;      // 进度条填充(矿脉)

    // 计时
    public long lastFrameAt;
    public int lastBombTickSec = -1;
    public int lastTenSecTick = -1;
    public int lastBoomSeq = 0;  // 已播声的爆炸事件序号
    // 素材实比(加载期从 PNG 头读出)
    public int minerW = 95;
    public int minerH = 136;

    public static MinerApp Create(GuiHost h) {
        MinerApp a = new MinerApp();
        // 首帧前先按宿主真实舞台同步 W/HOOK_X：此前 NewRun 的 Populate
        // 用的是 W=960 默认值，而手机舞台已延展到 ~1600，首关道具全铺
        // 在实际场地左侧 960 内，看起来"道具都在左边"。
        int sw = h.StageWidth();
        if (sw > 0) { Data.W = sw; }
        Data.HOOK_X = Data.W / 2;
        a.uiRng = Rng.Seed(20260904L);
        a.bgPath = MinerApp.FindAsset("assets/bg.jpg");
        a.campPath = MinerApp.FindAsset("assets/camp.png");
        a.minePath = MinerApp.FindAsset("assets/mine.png");
        a.clawSheetPath = MinerApp.FindAsset("assets/claw_sheet.png");
        a.minerSheetPath = MinerApp.FindAsset("assets/miner_sheet.png");
        a.glowPath = MinerApp.FindAsset("assets/glow.png");
        a.dynPath = MinerApp.FindAsset("assets/dynamite.png");
        a.bombPath = MinerApp.FindAsset("assets/bomb.png");
        a.hudBoardPath = MinerApp.FindAsset("assets/ui_hud_board.png");
        a.bombBoardPath = MinerApp.FindAsset("assets/ui_bomb_board.png");
        a.troughPath = MinerApp.FindAsset("assets/ui_trough.png");
        a.gaugePath = MinerApp.FindAsset("assets/ui_gauge.png");
        // 物品贴图统一成 assets/<tex>.png 一套（老版小图与新版美术已合并，
        // 运行时不再有"优先 x2、回退 x"的双份查找）。
        for (int i = 0; i < ItemDef.KIND_COUNT; i = i + 1) {
            ItemDef d = Data.DEFS[i];
            d.assetPath = MinerApp.FindAsset("assets/" + d.tex + ".png");
        }
        a.w = new World();
        a.w.rng = Rng.Seed((int)(DateTime.UtcNow().ToUnixSeconds() & 2147483647));
        a.w.Load();
        a.w.NewRun(a.w.rng);
        a.snd = Snd.Create();
        a.lastFrameAt = World.NowMs();
        // 按 PNG 头实比覆盖每个物品的绘制尺寸(保宽比,长边 = rad*2)
        int[] wh = new int[2];
        for (int i = 0; i < ItemDef.KIND_COUNT; i = i + 1) {
            ItemDef d = Data.DEFS[i];
            if (d.assetPath == null) { continue; }
            if (MinerApp.PngSize(d.assetPath, wh)) {
                int longEdge = d.rad * 2;
                if (wh[0] >= wh[1]) {
                    d.texW = longEdge;
                    d.texH = longEdge * wh[1] / wh[0];
                } else {
                    d.texH = longEdge;
                    d.texW = longEdge * wh[0] / wh[1];
                }
            }
        }
        // 矿工贴地站立:脚踩草地线,头顶让出兜底 HUD 顶栏带(此前
        // 头盔被顶栏罩住)。显示尺寸按**单帧**算——精灵表是左右两帧
        // 拼的,拿整张表的宽高比会把矿工拉宽一倍。
        a.minerH = Data.SKY_H - 54;
        a.minerW = a.minerH * GoldminerFacing.MinerFrameW
                        / GoldminerFacing.MinerFrameH;
        return a;
    }

    static string FindAsset(string rel) {
        string p = Assets.Find(rel);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 读 PNG 头 IHDR 取尺寸(大端) —— 见 Data.PngSize(用例要核对精灵表
    // 尺寸,函数放在不带窗口依赖的 Data 里)。
    static bool PngSize(string path, int[] outWH) {
        return Data.PngSize(path, outWH);
    }

    // 全出血横带 cover：把 path 按目标带纵横比裁一块铺满 (dw,dh)，
    // focus 0..1 选纵向取景位(0 顶 1 底)。ddz BlitCover 同款，多一个
    // 取景参数——营地/地层各取画面信息最厚的横带，不留 letterbox。
    static void BlitBand(Canvas c, string path, int dx, int dy, int dw, int dh,
                         double focus) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        int sy = (int)((ih - sh) * focus);
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(dx + CDraw.originX),
                    CDraw.MapY(dy + CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, sy, sw, sh);
    }

    // 逻辑推进
    public void StepFrame(int dtMs) {
        this.w.Step(dtMs);
        World w = this.w;
        // 音效钩子
        if (w.state == World.ST_BOMB) {
            int sec = w.bombTimeLeft / 300;
            if (sec != this.lastBombTickSec) {
                this.lastBombTickSec = sec;
                this.snd.Play(this.snd.bombtick, 0.5);
            }
        }
        // 爆炸声:World 只记事件序号(boomSeq)与音色(boomTnt),
        // 宿主每帧轮询补声——TNT 连锁/玩家炸药/拆弹失败共用一条通道。
        if (w.boomSeq != this.lastBoomSeq) {
            this.lastBoomSeq = w.boomSeq;
            this.snd.Play(w.boomTnt != 0 ? this.snd.tntboom : this.snd.boom, 0.8);
        }
        if (w.hurryPlayed && w.timeLeftMs > 0 && w.state != World.ST_RESULT) {
            int sec = w.timeLeftMs / 1000;
            if (sec <= 10 && sec != this.lastTenSecTick) {
                this.lastTenSecTick = sec;
                this.snd.Play(this.snd.tick, 0.5);
            }
        }
    }

    // 输入触发(点击/空格/下/回车)
    public void OnActionKey() {
        World w = this.w;
        if (w.state == World.ST_RESULT) {
            if (w.ConfirmResult()) {
                if (w.levelResult > 0) {
                    this.snd.Play(this.snd.levelup, 0.7);
                }
            }
            return;
        }
        if (w.state == World.ST_SWING) {
            this.snd.Play(this.snd.swing, 0.5);
        } else if (w.state == World.ST_QTE || w.state == World.ST_BOMB) {
            this.snd.Play(this.snd.grab, 0.35);
        }
        w.Action();
    }

    public void OnDynamiteKey() {
        if (this.w.UseDynamite()) {
            this.snd.Play(this.snd.boom, 0.8);
            this.w.Float("炸掉了!", Data.HOOK_X, Data.HOOK_Y + 120, 255, 170, 80);
        }
    }

    // 场景渲染(游戏世界 + 兜底 HUD,全部 Canvas 直绘)
    public void DrawAll() {
        int w = Data.W;
        int h = Data.H;
        Canvas rd = this.c;
        World wo = this.w;
        // 震屏偏移
        int ox = 0;
        int oy = 0;
        if (wo.shakeFrames > 0) {
            ox = this.uiRng.Range(-wo.shakeMag, wo.shakeMag + 1) / 8;
            oy = this.uiRng.Range(-wo.shakeMag, wo.shakeMag + 1) / 8;
        }
        // 背景:天空带 + 地层带双横带 cover(接缝压在 SKY_H 草地线下,
        // 8px 交叠防震屏露缝);新图缺失回退旧整图,再缺回退渐变
        if (this.campPath != null && this.minePath != null) {
            MinerApp.BlitBand(rd, this.campPath, ox, oy, w, Data.SKY_H + 8,
                              0.55);
            MinerApp.BlitBand(rd, this.minePath, ox, oy + Data.SKY_H - 8, w,
                              h - Data.SKY_H + 8, 0.5);
        } else if (this.bgPath != null) {
            CDraw.BlitImage(rd, this.bgPath, ox, oy, w, h);
        } else {
            CDraw.FillVGrad(rd, 0, 0, w, h, CDraw.Argb(255, 96, 140, 200),
                            CDraw.Argb(255, 60, 40, 28));
        }
        // FEVER 热浪(>=3 连击:边缘暖光)
        if (wo.feverGlow > 0) {
            int ga = wo.feverGlow * 55 / 100;
            CDraw.RingRect(rd, ox + 2, oy + 2, w - 4, h - 4, 8, 255,
                           170 - ga / 3, 60, ga);
        }
        // 物品
        for (int i = 0; i < wo.items.Count; i = i + 1) {
            Item it = wo.items[i];
            if (!it.alive) { continue; }
            ItemDef d = Data.DEFS[it.kind];
            string tp = d.assetPath;
            double fy = Math.Sin(it.wob + this.now / 480.0) * 2.0;
            if (tp != null) {
                int dw = d.texW;
                int dh = d.texH;
                CDraw.BlitImage(rd, tp, ox + it.x - dw / 2,
                                oy + it.y - dh / 2 + (int)fy, dw, dh);
            } else {
                CDraw.FillCircle(rd, ox + it.x, oy + it.y + (int)fy, d.rad,
                                 200, 170, 60, 255);
            }
        }
        // 绳 + 爪 + 钩上物
        this.DrawClaw(ox, oy);
        // 矿工(双脚踩草地线 SKY_H,头部完整在画内,朝向跟着钩子走)
        this.DrawMiner(ox, oy);
        // 粒子
        for (int i = 0; i < wo.parts.Count; i = i + 1) {
            Particle p = wo.parts[i];
            int a = p.life * 255 / p.maxLife;
            CDraw.FillRect(rd, ox + (int)p.x - p.size / 2,
                           oy + (int)p.y - p.size / 2, p.size, p.size,
                           CDraw.Argb(a, p.r, p.g, p.b));
        }
        // 飘字(得分/提示,属于游戏世界的演出)
        for (int i = 0; i < wo.texts.Count; i = i + 1) {
            FloatText ft = wo.texts[i];
            int a = ft.life * 255 / 70;
            CText.DrawCenteredShadow(rd, ft.text, ox + ft.x, oy + ft.y - 20, 3,
                                     ft.r, ft.g, ft.b, a > 255 ? 255 : a);
        }
        // 场景内 QTE 圈(圈心跟着爪走,必须画在场景层)
        if (wo.state == World.ST_QTE) { this.DrawQte(ox, oy); }
        // 兜底 HUD:半透明顶栏(关卡/金币/进度/倒计时/炸药) + 结算与
        // 拆弹信息,保证游戏数据始终可读。
        this.DrawFallbackHud(ox, oy);
        // 爆炸白闪
        if (wo.flashFrames > 0) {
            int fa = wo.flashFrames * 38;
            if (fa > 255) { fa = 255; }
            CDraw.FillRect(rd, 0, 0, w, h, CDraw.Argb(fa, 255, 245, 220));
        }
    }

    // 场景层兜底 HUD:半透明顶栏(关卡/金币/进度/倒计时/炸药) +
    // 结算与拆弹覆盖。文本与场景飘字同一套 CText(系统字体,全 CJK
    // 带投影)。倒计时给到厘秒(原 Gui 控件树 HUD 同档,时间感知更紧)。
    void DrawFallbackHud(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        int pct = wo.Target() > 0 ? wo.gold * 100 / wo.Target() : 0;
        if (pct > 100) { pct = 100; }
        // 顶栏:美术底板九宫格自切铺满全宽(岩层横梁 + 金边 + 铆钉),
        // 不再是"半透明黑条 + 纯色块"。缺底板才回退纯色条。
        if (this.hudBoardPath != null) {
            GoldminerPaint.NineSlice(rd, this.hudBoardPath, ox, oy, Data.W, 46,
                                     GoldminerPaint.HudBoardBorder);
        } else {
            CDraw.FillRect(rd, ox, oy, Data.W, 46, CDraw.Argb(215, 12, 14, 20));
        }
        // HUD 文字压在岩层上，用描边保证可读（不靠系统默认字色）
        GoldminerPaint.TextOutlined(rd, "第 " + Convert.ToString(wo.level) + " 关",
                                    ox + 16, oy + 10, 2,
                                    243, 233, 210, 255, 18, 15, 12, 220);
        GoldminerPaint.TextOutlined(rd, "$" + Convert.ToString(wo.gold) + "/"
                                    + Convert.ToString(wo.Target()),
                                    ox + 140, oy + 10, 2,
                                    232, 190, 96, 255, 18, 15, 12, 220);
        // 进度条:凹槽 + 矿脉条,两段都是九宫格底板
        if (this.troughPath != null) {
            GoldminerPaint.NineSlice(rd, this.troughPath, ox + 360, oy + 17,
                                     200, 12, GoldminerPaint.TroughBorder);
        } else {
            CDraw.FillRect(rd, ox + 360, oy + 17, 200, 12, CDraw.Argb(255, 40, 44, 56));
        }
        if (pct > 0) {
            if (this.gaugePath != null) {
                GoldminerPaint.NineSlice(rd, this.gaugePath, ox + 362, oy + 19,
                                         196 * pct / 100, 8,
                                         GoldminerPaint.GaugeBorder);
            } else {
                CDraw.FillRect(rd, ox + 362, oy + 19, 196 * pct / 100, 8,
                               CDraw.Argb(255, 232, 190, 96));
            }
        }
        // 右侧从右往左排(倒计时/连击/炸药),量宽定位互不重叠
        int totalCs = (wo.timeLeftMs + 5) / 10;
        int cs = totalCs % 100;
        bool urgent = totalCs <= 1000;
        int xr = ox + Data.W - 16;
        string dtxt = "Q 炸药 x" + Convert.ToString(wo.dynamites);
        int dw = CText.Width(dtxt, 2);
        if (this.dynPath != null) {
            int isz = 26;  // 炸药随身包(97x120 实比)
            CDraw.BlitImage(rd, this.dynPath, xr - dw - 8 - isz * 97 / 120,
                            oy + 8, isz * 97 / 120, isz);
        }
        GoldminerPaint.TextOutlined(rd, dtxt, xr - dw, oy + 10, 2,
                                    200, 194, 174, 255, 18, 15, 12, 220);
        xr = xr - dw - 28;
        string ttxt = "剩余 " + Convert.ToString(totalCs / 100) + "." +
                      (cs < 10 ? "0" : "") + Convert.ToString(cs) + " 秒";
        int tw = CText.Width(ttxt, 2);
        GoldminerPaint.TextOutlined(rd, ttxt, xr - tw, oy + 10, 2,
                                    urgent ? 250 : 232,
                                    urgent ? 120 : 226,
                                    urgent ? 96 : 212, 255, 18, 15, 12, 220);
        xr = xr - tw - 28;
        if (wo.combo.count >= 2) {
            string ctxt = "连击 x" + Convert.ToString(wo.combo.count);
            int cw = CText.Width(ctxt, 2);
            GoldminerPaint.TextOutlined(rd, ctxt, xr - cw, oy + 10, 2,
                                        240, 176, 80, 255, 18, 15, 12, 220);
        }
        // 拆弹覆盖:警示底板(九宫格) + 弹体 + 柔光晕
        if (wo.state == World.ST_BOMB) {
            if (this.bombBoardPath != null) {
                GoldminerPaint.NineSlice(rd, this.bombBoardPath,
                                         ox + Data.W / 2 - 170, oy + 230,
                                         340, 150,
                                         GoldminerPaint.BombBoardBorder);
            } else {
                CDraw.FillRect(rd, ox + Data.W / 2 - 170, oy + 230, 340, 150,
                               CDraw.Argb(205, 10, 12, 17));
                CDraw.FillRect(rd, ox + Data.W / 2 - 170, oy + 230, 340, 3,
                               CDraw.Argb(255, 192, 85, 63));
            }
            int tx = ox + Data.W / 2;
            if (this.bombPath != null) {
                // 弹体贴面板左侧,柔光晕按帧缩放脉动;文字整体右移让位
                int bw = 72 * 96 / 118;  // 弹体(96x118 实比)
                int bx = ox + Data.W / 2 - 156;
                int by = oy + 269;
                if (this.glowPath != null) {
                    int g = 150 + (int)(Math.Sin(this.now / 110.0) * 12.0);
                    CDraw.BlitImage(rd, this.glowPath,
                                    bx + bw / 2 - g / 2, by + 36 - g / 2, g, g);
                }
                CDraw.BlitImage(rd, this.bombPath, bx, by, bw, 72);
                tx = tx + 30;
            }
            GoldminerPaint.TextCenteredOutlined(rd, "疯狂点击! 拆除炸弹!",
                                                tx, oy + 252, 3,
                                                240, 176, 80, 255, 18, 15, 12, 230);
            GoldminerPaint.TextCenteredOutlined(rd,
                                                Convert.ToString(wo.bombClicks) + "/"
                                                + Convert.ToString(wo.bombNeed) + "    "
                                                + Convert.ToString(wo.bombTimeLeft / 1000 + 1)
                                                + " 秒",
                                                tx, oy + 312, 2,
                                                232, 226, 212, 255, 18, 15, 12, 230);
        }
        // 画布只保留定格的对局画面,不再叠画结算面板。
    }

    // 爪与绳。爪子用**离线烘焙的方向精灵表**（client/tools/bake_assets.py
    // → assets/claw_sheet.png，12 帧覆盖摆角区间 [25,155]）：引擎运行时
    // 转不了图（Canvas.BlitImage 只有源矩形，没有旋转也没有水平翻转），
    // 所以朝向只能在素材阶段烘好，运行时按摆角取帧
    // （GoldminerFacing.ClawFrame，纯函数）。
    //
    // 绳头严格接在精灵表的**铰点**上：铰点 = 咬合点 - 指向方向·(帧内
    // 咬合线到铰点的距离)。原先绳头接的是矢量爪的几何铰点（爪心-ch/2），
    // 而画出来的钩子在那点**上方 22px**——绳子与钩子之间是断的（链条
    // 错位）。现在绳头、矿灯、钩尖三者同一个像素点。
    void DrawClaw(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        double rad = wo.angle * Math.PI / 180.0;
        double ca = Math.Cos(rad);
        double sa = Math.Sin(rad);
        // 咬合点 = 绳锚点 + 指向方向·绳长（与 World 的抓取判定同一个点）
        int cx = ox + Data.HOOK_X + (int)(ca * wo.clawLen);
        int cy = oy + Data.HOOK_Y + (int)(sa * wo.clawLen);
        double sc = GoldminerFacing.ClawScale();
        int grip = (int)((GoldminerFacing.ClawPinchY
                          - GoldminerFacing.ClawHingeY) * sc);
        int ex = cx - (int)(ca * grip);
        int ey = cy - (int)(sa * grip);
        // 钩上物：画在**爪钳咬合点**，且画在爪子**下面**——爪子咬住它，
        // 不是它盖住爪子。贴图保持直立（运行时转不了图）。
        if (wo.hookedKind >= 0) {
            ItemDef d = Data.DEFS[wo.hookedKind];
            string tp = d.assetPath;
            if (tp != null) {
                CDraw.BlitImage(rd, tp, cx - d.texW / 2, cy - d.texH / 2,
                                d.texW, d.texH);
            } else {
                CDraw.FillCircle(rd, cx, cy, d.rad, 200, 170, 60, 255);
            }
        }
        // 绳:从矿工胸口的卷筒(摆动圆心 HOOK_X,HOOK_Y)直拉到爪铰点。
        // 起点不再裁到矿工包围盒边缘——那样绳子会从镐尖或袖口"钻出来"。
        // 矿工是在绳子之后画的,矿工身上那一段自然被挡住,露出来的正好是
        // 卷筒到爪子的那一截。
        int sx0 = ox + Data.HOOK_X;
        int sy0 = oy + Data.HOOK_Y;
        // 两遍绳身:深色描边 + 亮芯。土色背景上不靠描边就看不见。
        // 绳上挂着重物时(受力反馈)绳身绷粗、亮芯转成绷紧的锈红。
        int ropeCol = GoldminerPaint.RopeTint(wo.tension);
        int th = 3 + wo.tension / 34;
        CDraw.Line(rd, sx0, sy0, ex, ey, th + 2, 30, 22, 16, 255);
        CDraw.Line(rd, sx0, sy0, ex, ey, th, (ropeCol >> 16) & 255,
                   (ropeCol >> 8) & 255, ropeCol & 255, 255);
        // 爪子:按摆角取方向帧,整帧贴出(帧内铰点位置固定)。
        if (this.clawSheetPath != null) {
            string src = CDraw.BlitSource(rd, this.clawSheetPath);
            if (src != null) {
                int frame = GoldminerFacing.ClawFrame(wo.angle);
                int dw = (int)(GoldminerFacing.ClawFrameW * sc);
                int dh = (int)(GoldminerFacing.ClawFrameH * sc);
                int dx2 = cx - (int)(GoldminerFacing.ClawPinchX * sc);
                int dy2 = cy - (int)(GoldminerFacing.ClawPinchY * sc);
                GoldminerPaint.Slice(rd, src, dx2, dy2, dw, dh,
                                     GoldminerFacing.ClawSrcX(frame), 0,
                                     GoldminerFacing.ClawFrameW,
                                     GoldminerFacing.ClawFrameH);
                return;
            }
        }
        // 兜底：素材缺失时画一个简化的三爪钩（不追求美术，只保证可玩）。
        CDraw.FillCircle(rd, ex, ey, 7, 70, 74, 86, 255);
        CDraw.Line(rd, ex, ey, cx, cy, 5, 120, 126, 140, 255);
        CDraw.Line(rd, ex - 6, ey, cx - 14, cy, 3, 156, 162, 176, 255);
        CDraw.Line(rd, ex + 6, ey, cx + 14, cy, 3, 156, 162, 176, 255);
    }

    // 矿工：双脚踩草地线，朝向跟着钩子走（左右两帧，GoldminerFacing
    // 取帧）。钩上挂着重物时矿工被拽得后仰——偏移量读 World.tension。
    void DrawMiner(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        if (this.minerSheetPath == null) {
            CDraw.FillCircle(rd, ox + Data.HOOK_X, oy + Data.HOOK_Y - 40, 34,
                             220, 160, 60, 255);
            return;
        }
        string src = CDraw.BlitSource(rd, this.minerSheetPath);
        if (src == null) {
            CDraw.FillCircle(rd, ox + Data.HOOK_X, oy + Data.HOOK_Y - 40, 34,
                             220, 160, 60, 255);
            return;
        }
        // 受力后仰：钩子在右边就把矿工往左拽（反方向），重量越大越明显。
        int rec = wo.tension / 12;
        int rx = 0 - (int)(Math.Cos(wo.angle * Math.PI / 180.0) * rec);
        int ry = rec / 2;
        int mw = this.minerW;
        int mh = this.minerH;
        GoldminerPaint.Slice(rd, src,
                             ox + Data.HOOK_X - mw / 2 + rx,
                             oy + Data.SKY_H + 6 - mh + ry,
                             mw, mh,
                             GoldminerFacing.MinerSrcX(wo.minerFacing), 0,
                             GoldminerFacing.MinerFrameW,
                             GoldminerFacing.MinerFrameH);
    }

    void DrawQte(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        double rad = wo.angle * Math.PI / 180.0;
        int cx = ox + Data.HOOK_X + (int)(Math.Cos(rad) * wo.clawLen);
        int cy = oy + Data.HOOK_Y + (int)(Math.Sin(rad) * wo.clawLen);
        // 金圈(命中区)
        CDraw.CircleStroke(rd, cx, cy, 44, 2, 255, 210, 80, 255);
        // 白圈(收缩)
        int wr = (int)wo.qte.radius;
        if (wr < 8) { wr = 8; }
        CDraw.CircleStroke(rd, cx, cy, wr, 2, 255, 255, 255, 235);
        // 进度点
        for (int i = 0; i < wo.qte.need; i = i + 1) {
            int dx = cx - wo.qte.need * 10 + i * 20 + 5;
            if (i < wo.qte.done) {
                CDraw.FillCircle(rd, dx, cy + 74, 6, 130, 240, 120, 255);
            } else {
                CDraw.FillCircle(rd, dx, cy + 74, 6, 70, 70, 80, 255);
            }
        }
        // 操作提示(圈心过深时画到圈上方)
        int hy = cy + 96;
        if (hy > Data.H - 20) { hy = cy - 74; }
        CText.DrawCenteredShadow(rd, "白圈缩进金圈时点击!", cx, hy, 2,
                                 232, 226, 212, 255);
    }

    // 入口与无头自测
    static int Main(string[] args) {
        // 文字脸:圆体(幼圆)比系统 UI 字体更配游戏画风;机器上没有
        // 幼圆时 GDI 字体链接自动回退系统默认。运行库首次建字体时
        // 读一次该变量。
        Environment.SetEnvironmentVariable("ZAN_GUI_FONT_FACE", "幼圆");
        // 无头平衡仿真:自动打 8 关,校验经济曲线与状态机(不建窗口)
        if (ProcessHost.Env("MINER_SIM") == "1") {
            return MinerApp.SimRun();
        }
        // 皮肤资源自检:证明"基线与皮肤包都由编译器内嵌、磁盘不必再放 base.css"。
        // 纯读内嵌资源,不开窗口(这条判不了,只能靠断言)。
        if (args != null && args.Length > 0 && args[0] == "skin-probe") {
            return MinerApp.SkinProbe();
        }
        SceneRouter router = new MnRouter(new GuiHost("黄金矿工", Data.W,
                                                      Data.H, 16));
        MinerApp a = MinerApp.Create(router.Host());
        router.Register("play", new MnPlayScene(a));
        router.Register("over", new MnOverScene(a));
        // 结算页直开（视觉自检用）：MINER_SCENE=over。
        // 截图只用来判"好不好看/像不像"——"换没换成功"由断言判
        // （MINER_SKIN_PROBE 打出生效的皮肤名）。
        bool overOnly = ProcessHost.Env("MINER_SCENE") == "over";
        router.Run(overOnly ? "over" : "play");
        return 0;
    }

    // 皮肤资源自检(不开窗口):把"内嵌里有什么、磁盘上有什么"打成两行,
    // 测试脚本据此断言:
    //   embed_base=1        编译器自动内嵌的控件基线(base.css)在
    //   embed_dark=1        底座皮肤 dark 在
    //   embed_pack=1        本游戏皮肤包在(构建脚本 --embed 单文件规格)
    //   embed_assets_pack=1 assets/ 整目录内嵌时皮肤包也在(另一条路径)
    //   disk_base=0         磁盘上**没有**手工拷的基线——拷了会盖住内嵌兜底
    //   disk_pack=1         磁盘上有本游戏皮肤包副本(改 CSS 不用重编)
    // 跑法:GoldMiner.exe skin-probe
    static int SkinProbe() {
        string baseCss = "";
        string packCss = "";
        if (File.EmbedExists("skins/base.css")) {
            baseCss = File.ReadAllText("skins/base.css");
        }
        if (File.EmbedExists("skins/goldminer/skin.css")) {
            packCss = File.ReadAllText("skins/goldminer/skin.css");
        }
        bool dark = File.EmbedExists("skins/dark/skin.css");
        bool assetsPack = File.EmbedExists("assets/skins/goldminer/skin.css");
        bool diskBase = File.Exists(Assets.ExeDir() + "/skins/base.css");
        bool diskPack = File.Exists(Assets.ExeDir() + "/skins/goldminer/skin.css");
        bool packToken = packCss.IndexOf("--primary: #FFE8BE60;") >= 0;
        Console.WriteLine("SKIN embed_base=" + (baseCss.Length > 0 ? 1 : 0)
                          + " embed_dark=" + (dark ? 1 : 0)
                          + " embed_pack=" + (packCss.Length > 0 ? 1 : 0)
                          + " embed_assets_pack=" + (assetsPack ? 1 : 0));
        Console.WriteLine("SKIN base_len=" + baseCss.Length
                          + " pack_len=" + packCss.Length
                          + " pack_token=" + (packToken ? 1 : 0)
                          + " disk_base=" + (diskBase ? 1 : 0)
                          + " disk_pack=" + (diskPack ? 1 : 0));
        bool ok = baseCss.Length > 0 && dark && packCss.Length > 0 && packToken
                  && !diskBase;
        return ok ? 0 : 1;
    }

    // 无头仿真:模拟一个"会连点的中等玩家"打关,输出经济快照 + 不变量检查。
    // MINER_SIM_SEED 覆盖随机种子(默认 424242),便于多种子回归。
    static int SimRun() {
        StreamWriter log = new StreamWriter("miner_sim.log");
        long seed = 424242L;
        string seedEnv = ProcessHost.Env("MINER_SIM_SEED");
        if (seedEnv != null && seedEnv.Length > 0) {
            seed = Data.ParseIntS(seedEnv);
        }
        log.WriteLine("=== MINER_SIM headless seed=" + seed + " ===");
        World w = new World();
        w.rng = Rng.Seed(seed);
        w.NewRun(w.rng);
        bool allOk = true;
        int wonLevels = 0;
        for (int lv = 1; lv <= 8; lv = lv + 1) {
            if (lv > 1) {
                // 与真实流程一致:上一关结算确认后才进入下一关
                // (ConfirmResult 里 level+1)。SIM 每关限时从 L1 拍起,
                // 这里按 w.level 对齐,失败即停。
                if (w.level != lv) { break; }
            }
            w.StartLevel();
            int target = w.Target();
            int field = 0;
            for (int i = 0; i < w.items.Count; i = i + 1) {
                ItemDef d = Data.DEFS[w.items[i].kind];
                if (!d.junk && d.score > 0) { field = field + d.score; }
            }
            log.WriteLine("L" + w.level + " target=" + target
                          + " items=" + w.items.Count
                          + " field=" + field
                          + " need=" + (field > 0 ? target * 100 / field : 0) + "%"
                          + " swing=" + (int)w.angDir);
            // 模拟:60fps 推进,贪心策略 —— 摆到有价物角度就放钩。
            // 前摇:真实玩家会等扫过几轮看清全场再出手;AI 预热 2 秒,
            // 且目标价 < 120 的小鱼不碰,省下收线时间。
            int frames = w.LevelTimeMs() / 16;
            int captured = 0;
            for (int f = 0; f < frames && w.state != World.ST_RESULT; f = f + 1) {
                // 简单 AI:沿整条摆动射线扫描(120..600),选射线近旁最优目标
                if (w.state == World.ST_SWING) {
                    double rad = w.angle * Math.PI / 180.0;
                    Item best = null;
                    int bestScore = 0;
                    if (f > 120) {
                        for (int i = 0; i < w.items.Count; i = i + 1) {
                            Item it = w.items[i];
                            if (!it.alive) { continue; }
                            int dx = it.x - Data.HOOK_X;
                            int dy = it.y - Data.HOOK_Y;
                            // 物品在射线上的投影长度与垂距
                            double proj = dx * Math.Cos(rad) + dy * Math.Sin(rad);
                            if (proj < 110.0 || proj > 620.0) { continue; }
                            double perp = Math.Abs(-dx * Math.Sin(rad)
                                                   + dy * Math.Cos(rad));
                            if (perp > 26.0) { continue; }  // 爪半径内才算可抓
                            int sc = Data.DEFS[it.kind].score;
                            if (it.kind == 8 || it.kind == 9) { sc = -1; }  // 避开
                            // 终局放宽:收线要好几秒,小鱼平时不值当;
                            // 最后 15 秒有啥抓啥(石头除外),模拟真人抢分
                            int minFish = w.timeLeftMs < 15000 ? 30 : 100;
                            if (sc > 0 && sc < minFish) { sc = 0; }
                            // 价值/重量性价比优先
                            if (sc > 0) {
                                sc = sc * 10 / (Data.DEFS[it.kind].weight + 4);
                            }
                            // 路径遮挡:更近处若有垃圾/TNT 挡道,收益打折
                            // (HitTest 按数组序返回第一个命中,近物先被抓)
                            if (sc > 0) {
                                for (int j = 0; j < w.items.Count; j = j + 1) {
                                    Item ob = w.items[j];
                                    if (!ob.alive || ob == it) { continue; }
                                    if (ob.kind == 8) { continue; }  // TNT 单算
                                    int ox = ob.x - Data.HOOK_X;
                                    int oy = ob.y - Data.HOOK_Y;
                                    double oproj = ox * Math.Cos(rad)
                                                   + oy * Math.Sin(rad);
                                    if (oproj < 110.0 || oproj > proj - 10.0) {
                                        continue;
                                    }
                                    double operp = Math.Abs(
                                        -ox * Math.Sin(rad) + oy * Math.Cos(rad));
                                    if (operp > 26.0) { continue; }
                                    ItemDef od = Data.DEFS[ob.kind];
                                    int obMin = w.timeLeftMs < 15000 ? 30 : 100;
                                    if (od.junk || od.score < obMin) {
                                        sc = 0;  // 垃圾挡道必被抓到,别浪费收线时间
                                        break;
                                    }
                                }
                            }
                            if (sc > bestScore) { bestScore = sc; best = it; }
                        }
                    }
                    if (best != null) { w.Action(); captured = captured + 1; }
                } else if (w.state == World.ST_QTE) {
                    // AI:白圈进入金圈即命中(20% 空点,模拟手残)
                    if (w.qte.InWindow() && f % 5 != 0) {
                        w.Action();
                    }
                } else if (w.state == World.ST_BOMB) {
                    w.Action();  // 疯狂点击
                } else if (w.state == World.ST_RETRACT
                           && w.hookedKind == 6 && w.dynamites > 0) {
                    w.UseDynamite();  // 石头不上桌:用炸药止损
                }
                w.Step(16);
            }
            log.WriteLine("  -> gold=" + w.gold + "/" + target
                          + " result=" + (w.levelResult > 0 ? "WIN" : "FAIL")
                          + " actions=" + captured
                          + " timeLeft=" + w.timeLeftMs);
            // 不变量
            if (w.gold < 0) { log.WriteLine("  !! gold < 0"); allOk = false; }
            if (w.items.Count == 0) { log.WriteLine("  !! no items"); allOk = false; }
            if (w.levelResult == 0) {
                log.WriteLine("  !! level did not end");
                allOk = false;
                break;
            }
            if (w.levelResult > 0) {
                wonLevels = wonLevels + 1;
                // ConfirmResult 要求结算画面停留 600ms;SIM 里直接推
                // 进 1 秒再确认,走真实过关流程(level+1)。
                w.Step(1000);
                w.ConfirmResult();
            } else {
                break;  // 经济到顶:失败即停(曲线过陡的信号)
            }
        }
        // 平衡口径:8 种子中位推进 L5+、最差 L2+。曲线过陡(中位
        // 低于 L3)或过缓(中位 L8 通关)都会被这里拦下。
        if (wonLevels < 2) {
            log.WriteLine("  !! balance: only " + wonLevels
                          + " of first levels won");
            allOk = false;
        }
        log.WriteLine(allOk ? "=== SIM PASS ===" : "=== SIM FAIL ===");
        log.WriteLine("bestLevel=" + w.bestLevel + " totalGold=" + w.totalGold);
        log.Close();
        Console.WriteLine(allOk ? "SIM PASS" : "SIM FAIL");
        return allOk ? 0 : 1;
    }
}

// 对局：纯 canvas 场景（HtmlFile 为空，无 HTML 层）。世界由
// MinerApp.Create 开好第一关，进场即玩；结算状态（ST_RESULT）在
// FixedStep 里路由到结算场景。
